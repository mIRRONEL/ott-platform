# Database Credentials
# PostgreSQL
POSTGRES_DB=ott_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ott_platform

# PostgreSQL Application User (created during initialization)
DB_APP_USER=ott_user
DB_APP_PASSWORD=ott_password_secure

# MongoDB
MONGO_INITDB_DATABASE=ott_platform
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root_password_secure
MONGODB_URI=mongodb://ott_user:ott_password_secure@mongodb:27017/ott_platform

# MongoDB Application User (created during initialization)
MONGO_APP_USER=ott_user
MONGO_APP_PASSWORD=ott_password_secure

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# Kafka
KAFKA_BROKER=kafka:29092
KAFKA_ADVERTISED_BROKER=localhost:9092
KAFKA_ZOOKEEPER=zookeeper:2181

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=refresh-secret

# Upload Configuration
UPLOAD_DIR=/tmp/ott-uploads
HLS_OUTPUT_DIR=/tmp/ott-hls
MAX_FILE_SIZE=5GB

# Services URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3003
STREAMING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
ANALYTICS_SERVICE_URL=http://localhost:3007

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
