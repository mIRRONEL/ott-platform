# Server
NODE_ENV=development
PORT=3006
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://notification_user:notification_pass@localhost:5432/notification_db
MONGODB_URI=mongodb://localhost:27017/notification_db

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=notification-service

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@gmail.com

# Email Configuration
EMAIL_FROM=noreply@ottplatform.com
EMAIL_FROM_NAME=OTT Platform

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3003
STREAMING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
