# User Service Configuration

# Server
PORT=3002
NODE_ENV=development

# Database
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ott_platform

# MongoDB
MONGODB_URL=mongodb://mongodb:27017/ott_platform

# Redis
REDIS_URL=redis://redis:6379

# Kafka
KAFKA_BROKERS=kafka:29092

# CORS
CORS_ORIGIN=http://api-gateway:3000

# Logging
LOG_LEVEL=info
