# Server
NODE_ENV=development
PORT=3007
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ott_platform
MONGODB_URI=mongodb://localhost:27017/analytics_db

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=analytics-service

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
CONTENT_SERVICE_URL=http://localhost:3003
STREAMING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006

# CORS
CORS_ORIGIN=http://localhost:3000
