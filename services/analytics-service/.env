# Server
NODE_ENV=development
PORT=3007
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/ott_platform
MONGODB_URI=mongodb://mongodb:27017/analytics_db

# Redis
REDIS_URL=redis://redis:6379

# Kafka
KAFKA_BROKERS=kafka:29092
KAFKA_CONSUMER_GROUP=analytics-service

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Service URLs
AUTH_SERVICE_URL=http://auth-service:3001
USER_SERVICE_URL=http://user-service:3002
CONTENT_SERVICE_URL=http://content-service:3003
STREAMING_SERVICE_URL=http://streaming-service:3004
PAYMENT_SERVICE_URL=http://payment-service:3005
NOTIFICATION_SERVICE_URL=http://notification-service:3006

# CORS
CORS_ORIGIN=http://api-gateway:3000
