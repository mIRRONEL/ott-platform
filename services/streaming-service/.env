# Streaming Service Configuration

# Server
PORT=3004
NODE_ENV=development

# MongoDB
MONGODB_URL=mongodb://mongodb:27017/ott_platform

# Redis
REDIS_URL=redis://redis:6379

# Kafka
KAFKA_BROKERS=kafka:29092

# CDN
CDN_URL=https://cdn.example.com
API_URL=http://streaming-service:3004

# CORS
CORS_ORIGIN=http://api-gateway:3000

# Logging
LOG_LEVEL=info
